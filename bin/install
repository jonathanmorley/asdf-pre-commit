#!/usr/bin/env bash

set -Eeuo pipefail

if [[ -z ${ASDF_DOWNLOAD_PATH:-} ]]; then
  # No download path specified, create a temp one
  ASDF_DOWNLOAD_PATH="$(mktemp -d)"
  export ASDF_DOWNLOAD_PATH
  bash "$(dirname "$0")/download"
fi

mkdir -p "${ASDF_INSTALL_PATH}/bin"
mv "${ASDF_DOWNLOAD_PATH}/pre-commit" "${ASDF_INSTALL_PATH}/bin/pre-commit"
chmod +x "${ASDF_INSTALL_PATH}/bin/pre-commit"
